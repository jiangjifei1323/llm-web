# 复制为 .env 并填入真实配置（.env 已被 git 忽略）
# 支持任意 OpenAI 兼容服务：OpenAI / DeepSeek / 通义 / Moonshot 等
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# Embedding 模型配置（用于向量化）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Rerank 模型配置（用于重排序）
RERANK_API_KEY=
RERANK_BASE_URL=https://maas.qianwenaiapi.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# PostgreSQL 连接配置（SQLAlchemy + psycopg）
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/llm_db

# JWT 签名密钥（务必换成随机长字符串）与令牌有效期（小时）
# 生产环境（APP_ENV=production/prod）使用默认或过短密钥时后端会拒绝启动
APP_ENV=development
JWT_SECRET=请替换为随机字符串
JWT_EXPIRE_HOURS=24

# Agent（任务型执行）
AGENT_ENABLED=true
AGENT_WORKERS=2
AGENT_MAX_STEPS=8
AGENT_MAX_LLM_CALLS=20
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_TOKENS=100000
AGENT_DEADLINE_MINUTES=10
AGENT_MAX_REPLANS=2
AGENT_MAX_RETRIES=1
# 需人工审批的风险级别（write/external）；空表示不启用 HITL
HITL_RISKS=write,external
HITL_TIMEOUT_MINUTES=30
# 启用的工具白名单（逗号分隔）；可追加 web_search,http_request
TOOLS_ENABLED=datetime_calc,kb_search,kb_list
# 可选：联网搜索（未配 Key 时 web_search 走 DuckDuckGo 摘要）
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.duckduckgo.com/
# 可选：http_request 域名白名单（逗号分隔）；空则拒绝全部
HTTP_ALLOWLIST=
