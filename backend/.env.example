# 复制为 .env 并填入真实配置（.env 已被 git 忽略）
# 支持任意 OpenAI 兼容服务：OpenAI / DeepSeek / 通义 / Moonshot 等
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# PostgreSQL 连接配置（SQLAlchemy + psycopg）
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/llm_db

# JWT 签名密钥（务必换成随机长字符串）与令牌有效期（小时）
JWT_SECRET=请替换为随机字符串
JWT_EXPIRE_HOURS=24
