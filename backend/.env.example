# 复制为 .env 并填入真实配置（.env 已被 git 忽略）
# 支持任意 OpenAI 兼容服务：OpenAI / DeepSeek / 通义 / Moonshot 等
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# Embedding 模型配置（用于向量化）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Rerank 模型配置（用于重排序）
RERANK_API_KEY=
RERANK_BASE_URL=https://maas.qianwenaiapi.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# PostgreSQL 连接配置（SQLAlchemy + psycopg）
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/llm_db

# JWT 签名密钥（务必换成随机长字符串）与令牌有效期（小时）
JWT_SECRET=请替换为随机字符串
JWT_EXPIRE_HOURS=24
